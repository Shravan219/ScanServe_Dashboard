{
  "name": "vyoma-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rimraf dist release || exit 0",
    "lint": "tsc --noEmit",
    "pack:win": "npm run clean && npm run build && electron-packager . Vyoma --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/icon.ico --ignore=\"^/(src|\\.git)\" --prune=true",
    "cap:sync": "vite build && cap sync android",
    "apk:build": "vite build && cap sync android && cd android && gradlew.bat assembleDebug && cd .. && powershell -Command \"Copy-Item android/app/build/outputs/apk/debug/app-debug.apk apk/Vyoma_ScanServe_Dashboard_v1.0.apk -Force; Copy-Item android/app/build/outputs/apk/debug/app-debug.apk Vyoma_ScanServe.apk -Force\"",
    "apk:install": "node scripts/install-apk.cjs",
    "apk:devices": "node scripts/install-apk.cjs --devices-only"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "react-to-print": "^3.3.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14"
  },
  "build": {
    "appId": "com.vyoma.app",
    "productName": "Vyoma",
    "directories": {
      "output": "dist_app"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}